{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write \"resources/**/*.{js,jsx,css,json}\"",
        "format:php": "./vendor/bin/pint",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint resources/js --no-warn-ignored",
        "lint:fix": "eslint resources/js --no-warn-ignored --fix",
        "lint:css-classes": "node scripts/find-unstyled-classes.mjs",
        "lint:radius": "node scripts/check-radius.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@inertiajs/react": "^2.0.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.6",
        "@vitejs/plugin-react": "^6.1.0",
        "autoprefixer": "^10.4.12",
        "concurrently": "^10.0.3",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^15.15.0",
        "jsdom": "^28.1.0",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.4.31",
        "prettier": "^3.9.6",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "vite": "^8.0.0",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "formik": "^2.4.9",
        "lucide-react": "^1.31.0",
        "yup": "^1.7.1",
        "zustand": "^5.0.15"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.3"
    }
}
